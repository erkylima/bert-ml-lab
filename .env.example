# BERT ML Laboratory - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# JUPYTER CONFIGURATION
# ============================================
# Hash da senha 'minhasenha' gerado automaticamente
# Para gerar novo hash: python3 scripts/generate_jupyter_hash.py
JUPYTER_TOKEN=sha1:VLWq5gkwf1an:4f3377bb5da7e3a3b9f688139c1ffb04d51949eb
JUPYTER_PORT=8888
JUPYTER_IP=0.0.0.0

# ============================================
# HUGGING FACE CONFIGURATION
# ============================================
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
HF_CACHE_DIR=/workspace/.cache
HF_MODEL_CACHE=/workspace/.cache/huggingface

# ============================================
# MODEL CONFIGURATION
# ============================================
BERTIMBAU_MODEL=neuralmind/bert-base-portuguese-cased
SENTIMENT_MODEL=bert-base-uncased
MISTRAL_MODEL=mistralai/Mistral-7B-v0.1

# ============================================
# TRAINING CONFIGURATION
# ============================================
TRAIN_BATCH_SIZE=8
EVAL_BATCH_SIZE=16
LEARNING_RATE=2e-5
NUM_EPOCHS=3
WARMUP_STEPS=500
MAX_SEQ_LENGTH=512

# ============================================
# DATA PATHS
# ============================================
DATA_RAW_DIR=/workspace/data/raw
DATA_PROCESSED_DIR=/workspace/data/processed
MODELS_DIR=/workspace/models
RESULTS_DIR=/workspace/results

# ============================================
# REPRODUCIBILITY
# ============================================
SEED=42
DETERMINISTIC=true

# ============================================
# DOCKER CONFIGURATION
# ============================================
DOCKER_SHARED_MEMORY=16gb
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility